# ─────────────────────────────────────────────────────────────
# Mit-Mak Motors — environment variables
# Copy to `.env.local` for local dev. Set the same keys in Vercel.
# Everything has a sensible fallback, so the site runs with none set.
# ─────────────────────────────────────────────────────────────

# Canonical site URL — used for metadata, OpenGraph, sitemap & robots.
NEXT_PUBLIC_SITE_URL=https://mitmakmotors.co.za

# Quick-action contact details (header + floating buttons + footer).
NEXT_PUBLIC_PHONE=+27 12 004 0000
NEXT_PUBLIC_WHATSAPP=27600000000

# Where the multi-step forms POST. Leave blank to use the built-in
# /api/* mock handlers (they log + echo success) during development.
FORM_WEBHOOK_URL=

# Optional: Google Maps Embed API key for the Contact page map.
# Without it, the page renders a styled static map placeholder.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ─────────────────────────────────────────────────────────────
# Private Inventory Management System (admin dashboard)
# ALL OPTIONAL. With none set, the admin runs in keyless "demo mode":
# the public showroom serves the bundled inventory and admin edits use
# a local file store. Add these to make the admin fully live + persistent.
# ─────────────────────────────────────────────────────────────

# Database — makes the inventory live + persistent. Add a Postgres store in
# Vercel (Storage > Create Database > Postgres/Neon) and POSTGRES_URL is injected
# automatically; or paste any Postgres connection string here. The app creates
# its tables and imports the current inventory automatically on first use.
DATABASE_URL=

# Auth session secret — REQUIRED in production. Generate: openssl rand -base64 32
AUTH_SECRET=

# First Super Admin, seeded automatically on first run.
ADMIN_EMAIL=admin@mitmakmotors.co.za
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_NAME=Mit-Mak Admin

# Image uploads — add a Vercel Blob store (Storage > Create > Blob) and this
# token is injected automatically. Without it, admins paste image URLs instead.
BLOB_READ_WRITE_TOKEN=

# Enquiry alerts + password-reset emails via Resend (optional). Without a key,
# these are logged server-side and every enquiry is still saved to the dashboard.
RESEND_API_KEY=
EMAIL_FROM="Mit-Mak Motors <sales@mitmakmotors.co.za>"
LEADS_EMAIL=sales@mitmakmotors.co.za

# Public base URL for password-reset links (auto-detected if unset).
APP_URL=
